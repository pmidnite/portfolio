# Flask/Secret Keys
SECRET_KEY="your_secret_key_here"
JWT_SECRET_KEY="your_jwt_secret_key_here"
JWT_ACCESS_TOKEN_EXPIRES=3600

# API Auth credentials (replaces hardcoded username/password in generate_token.py)
API_USERNAME="your_api_username"
API_PASSWORD="your_api_password_here"

# Flask debug — set to true ONLY for local development
FLASK_DEBUG=false

# Database
DB_USERNAME="your_database_username"
DB_PASSWORD="your_database_password"
DB_HOST="localhost"
DB_NAME="portfolio"
# Optionally, you can override the full URI
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://username:password@host/database
SQLALCHEMY_POOL_RECYCLE=299
SQLALCHEMY_POOL_TIMEOUT=30

# Mail
MAIL_SERVER="smtp.gmail.com"
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME="your_email@gmail.com"
MAIL_PASSWORD="your_app_password"
MAIL_RECIPIENT="recipient_email@example.com"
